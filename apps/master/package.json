{
  "name": "master",
  "version": "1.0.0",
  "description": "MAD-OS Master Control",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "app:dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.mad.master",
    "productName": "MAD-OS-MASTER",
    "directories": {
      "output": "../../dist/master"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "clsx": "^1.2.1",
    "discord.js": "^14.27.0",
    "express": "^4.18.2",
    "framer-motion": "^10.12.16",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.244.0",
    "opusscript": "^0.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.6.2",
    "tailwind-merge": "^1.13.2"
  }
}
